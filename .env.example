# Example values for local development only; never use these defaults in production.
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
# Local database only. Verify DATABASE_URL before running the app; do not point tests at production.
DATABASE_URL=sqlite:///instance/yawmiyat.db
AUTO_CREATE_DB=1
# Local HTTP only. In production, set COOKIE_SECURE=1 only after HTTPS is verified.
COOKIE_SECURE=0
